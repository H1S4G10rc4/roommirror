{
  "name": "webcam-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "A simple always-on webcam monitor",
  "author": "Yuma",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.webcam.monitor",
    "productName": "Webcam Monitor",
    "artifactName": "Webcam-Monitor-${version}.${ext}",
    "directories": {
      "output": "outputs"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo"
    }
  }
}
