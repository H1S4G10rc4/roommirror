{
  "name": "roommirror",
  "version": "1.0.0",
  "private": true,
  "description": "A fixed 4:1 webcam viewer for use as a room mirror",
  "author": "Yuma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H1S4G10rc4/roommirror.git"
  },
  "homepage": "https://github.com/H1S4G10rc4/roommirror#readme",
  "bugs": {
    "url": "https://github.com/H1S4G10rc4/roommirror/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron --ozone-platform=x11 .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.h1s4g10rc4.roommirror",
    "productName": "Room mirror",
    "artifactName": "Room-mirror-${version}.${ext}",
    "directories": {
      "output": "outputs"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo"
    }
  }
}
